<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rain_background"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/rain_surface"
        android:padding="12dp"
        android:text="RAIN Private Browsing"
        android:textColor="@color/rain_accent"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/private_address_input"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Search or enter website"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:maxLines="1"
            android:textColor="@color/rain_text" />

        <Button
            android:id="@+id/private_go_button"
            style="@style/RainButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Go" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/private_webview_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/private_close_button"
        style="@style/RainButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Close Private Session" />
</LinearLayout>
