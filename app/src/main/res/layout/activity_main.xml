<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/top_toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="6dp">

        <ImageView
            android:id="@+id/rain_logo"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:clickable="true"
            android:contentDescription="@string/action_home"
            android:focusable="true"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher" />

        <EditText
            android:id="@+id/address_input"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/rain_address_background"
            android:hint="@string/address_hint"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:selectAllOnFocus="true"
            android:textColor="#173A60"
            android:textColorHint="#6E849C"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/top_new_tab_button"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/action_new_tab"
            android:focusable="true"
            android:gravity="center"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="25sp" />

        <TextView
            android:id="@+id/top_tabs_button"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/action_tabs"
            android:focusable="true"
            android:gravity="center"
            android:text="1"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/menu_button"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/browser_menu"
            android:focusable="true"
            android:gravity="center"
            android:text="☰"
            android:textColor="#FFFFFF"
            android:textSize="25sp" />
    </LinearLayout>

        <TextView android:id="@+id/mode_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />

    <LinearLayout
        android:id="@+id/actions_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button android:id="@+id/back_button" style="@style/RainButton" android:layout_width="wrap_content" android:text="@string/action_back" />
        <Button android:id="@+id/forward_button" style="@style/RainButton" android:layout_width="wrap_content" android:text="@string/action_forward" />
        <Button android:id="@+id/reload_button" style="@style/RainButton" android:layout_width="wrap_content" android:text="@string/action_reload" />
        <Button android:id="@+id/home_button" style="@style/RainButton" android:layout_width="wrap_content" android:text="@string/action_home" />
        <Button android:id="@+id/new_tab_button" style="@style/RainButton" android:layout_width="wrap_content" android:text="@string/action_new_tab" />
        <Button android:id="@+id/tabs_button" style="@style/RainButton" android:layout_width="wrap_content" android:text="@string/action_tabs" />
        <Button android:id="@+id/search_engine_button" style="@style/RainButton" android:layout_width="wrap_content" android:text="@string/action_search_engine" />
        <Button android:id="@+id/desktop_button" style="@style/RainButton" android:layout_width="wrap_content" android:text="@string/action_display_mode" />
        <Button android:id="@+id/zoom_out_button" style="@style/RainButton" android:layout_width="wrap_content" android:text="@string/action_zoom_out" />
        <Button android:id="@+id/zoom_in_button" style="@style/RainButton" android:layout_width="wrap_content" android:text="@string/action_zoom_in" />
        <Button android:id="@+id/text_out_button" style="@style/RainButton" android:layout_width="wrap_content" android:text="@string/action_text_out" />
        <Button android:id="@+id/text_in_button" style="@style/RainButton" android:layout_width="wrap_content" android:text="@string/action_text_in" />
        <Button android:id="@+id/private_button" style="@style/RainButton" android:layout_width="wrap_content" android:text="@string/action_private" />
        <Button android:id="@+id/protection_button" style="@style/RainButton" android:layout_width="wrap_content" android:text="@string/action_protection" />
        <Button android:id="@+id/permissions_button" style="@style/RainButton" android:layout_width="wrap_content" android:text="@string/action_permissions" />
        <Button android:id="@+id/bookmarks_button" style="@style/RainButton" android:layout_width="wrap_content" android:text="@string/action_bookmarks" />
        <Button android:id="@+id/history_button" style="@style/RainButton" android:layout_width="wrap_content" android:text="@string/action_history" />
        <Button android:id="@+id/resume_button" style="@style/RainButton" android:layout_width="wrap_content" android:text="@string/action_resume" />
        <Button android:id="@+id/videos_button" style="@style/RainButton" android:layout_width="wrap_content" android:text="@string/action_videos" />
        <Button android:id="@+id/settings_button" style="@style/RainButton" android:layout_width="wrap_content" android:text="@string/action_settings" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/page_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="#0877DF"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/webview_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#D9EEFF" />

    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EAF5FF"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingTop="5dp"
        android:paddingEnd="12dp"
        android:paddingBottom="5dp"
        android:text="@string/status_ready"
        android:textColor="#174675"
        android:textSize="11sp" />
</LinearLayout>